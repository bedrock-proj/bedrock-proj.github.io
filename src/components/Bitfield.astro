---
// Renders an instruction's opcode space, high bit first, including the framing bits
// from the instruction header. Digits are fixed bits; letters are operand fields; L is the
// extended-length field. A thicker rule marks each byte boundary.
interface Props {
  pattern: string;
}

const { pattern } = Astro.props;

// Header framing by pattern size (see instruction_word_formats in the spec).
const framing = pattern.length === 7 ? '0' : pattern.length === 14 ? '10' : '11LLLL';
const bits = framing + pattern;

type Kind = 'frame' | 'len' | 'fixed' | 'field';
const kindOf = (i: number, ch: string): Kind =>
  i < framing.length ? (ch === 'L' ? 'len' : 'frame') : /[01]/.test(ch) ? 'fixed' : 'field';

// Group runs of the same field letter, but never across a byte boundary.
const segments: { start: number; len: number; ch: string; kind: Kind }[] = [];
for (let i = 0; i < bits.length; i++) {
  const ch = bits[i];
  const kind = kindOf(i, ch);
  const last = segments[segments.length - 1];
  const groupable = kind === 'field' || kind === 'len';
  if (last && groupable && last.kind === kind && last.ch === ch && i % 8 !== 0) last.len++;
  else segments.push({ start: i, len: 1, ch, kind });
}
---

<span class="bits">
  {segments.map((s) => (
    <span class:list={[s.kind, { byte: s.start % 8 === 0 && s.start > 0 }]} style={`--len: ${s.len}`}>{s.ch}</span>
  ))}
</span>

<style>
  .bits {
    display: inline-flex;
    font: 500 10px/18px var(--mono);
    text-align: center;
  }
  .bits > span {
    width: calc(var(--len, 1) * var(--cell, 12px));
    border: 1px solid var(--faint);
    margin-right: -1px;
  }
  .bits > .byte {
    border-left: 1px solid var(--mute);
  }
  .fixed {
    color: var(--mute);
  }
  .frame {
    color: var(--fg);
    font-weight: 700;
  }
  .len {
    background: var(--faint);
    color: var(--fg);
  }
  .field {
    background: var(--accent-soft);
    color: var(--accent);
  }
</style>
